{
  "name": "mosslang",
  "version": "0.1.0",
  "description": "Moss: a small statically typed functional language (ML family) that compiles to JavaScript",
  "type": "module",
  "bin": {
    "moss": "./bin/moss.js"
  },
  "exports": {
    "./compiler": "./src/compiler/compile.ts",
    "./node": "./src/node.ts",
    "./runtime": "./src/runtime/index.ts",
    "./runtime/*": "./src/runtime/*"
  },
  "scripts": {
    "gen-stdlib": "node scripts/gen-stdlib.mjs",
    "pretest": "node scripts/gen-stdlib.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "moss": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
