(* The Prelude: opened implicitly in every module. Its names are global. *)

type 'a effect [@@opaque]
type ('k, 'v) map
type 'a option = None | Some of 'a

(* ---- async ---- *)
type 'a task [@@opaque]
type 'a remote = Loading | Loaded of 'a | Failed of string

(* ---- basics ---- *)
external show : int -> string = "show"

let not b = if b then false else true
let fst p = match p with (a, _) -> a
let snd p = match p with (_, b) -> b
let id x = x
